FROM node:24-bookworm-slim

WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./

ENV VITE_M0_DEMO=1
ENV VITE_MERNOKSZEM_URL=https://mernokszem-tender-cloud-demo-production.up.railway.app/

# Release only when validation inputs exist, the full test/benchmark suite passes,
# the dedicated M0 build succeeds, and the emitted bundle contains no forbidden
# cloud/AI/analytics endpoint strings.
RUN npm run check:m0

EXPOSE 4173

# Vite preview is a development server. The M0 runtime uses a tiny no-log static
# server that rejects non-GET methods and emits enforceable security headers.
CMD ["npm","run","serve:m0"]
