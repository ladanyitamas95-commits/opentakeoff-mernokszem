FROM node:24-bookworm-slim

WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./

ENV VITE_M0_DEMO=1
ENV VITE_MERNOKSZEM_URL=https://mernokszem-tender-cloud-demo-production.up.railway.app/

# Privacy/security changes are release-gated by the full web validation suite.
RUN npm run typecheck && npm run lint && npm test && npm run bench && npm run build

EXPOSE 4173

CMD ["npm","run","preview","--","--host","0.0.0.0","--port","4173"]
